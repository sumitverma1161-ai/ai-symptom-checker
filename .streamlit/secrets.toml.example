# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────
# Copy this to .streamlit/secrets.toml for local development,
# OR paste the key=value pairs into Streamlit Cloud App Settings → Secrets.
#
# The ML Diagnosis text model downloads and trains automatically
# from Kaggle on first load when these credentials are present.
#
# Get your Kaggle API key at: https://www.kaggle.com/settings → API → Create New Token
# ─────────────────────────────────────────────────────────────────

KAGGLE_USERNAME = "your_kaggle_username"
KAGGLE_KEY      = "your_kaggle_api_key"

# Optional: Gemini API key (for AI Symptom Checker & Lifestyle Guide pages)
# GEMINI_API_KEY = "your_gemini_api_key"
